<Window x:Class="BatteryDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BatteryDoctor.Models"
        xmlns:controls="clr-namespace:BatteryDoctor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Battery Doctor" Height="880" Width="1240" MinHeight="720" MinWidth="1020"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="FindingTemplate">
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,9">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,18" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" Cursor="Arrow">
                    <TextBlock Text="{Binding Loc[AppTitle], Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Loc[Subtitle], Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Loc[Language], Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                    <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" Margin="0,0,10,0"/>
                    <Button Content="{Binding Loc[Refresh], Mode=OneWay}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowControlButton}" Content="—" Click="OnMinimizeClick" ToolTip="{Binding Loc[Minimize], Mode=OneWay}"/>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowControlButton}" Content="□" Click="OnMaximizeRestoreClick" ToolTip="{Binding Loc[MaximizeRestore], Mode=OneWay}"/>
                    <Button Style="{StaticResource WindowCloseButton}" Content="✕" Click="OnCloseClick" ToolTip="{Binding Loc[Close], Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16,10,16,0" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Loc[Dashboard], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <Border Style="{StaticResource Card}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                Visibility="{Binding HasRecoveredInterruption, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding RecoveredInterruptionTitle}" FontSize="20" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding RecoveredInterruptionDetail}" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredBatteryReliability}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredBatteryReliability], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredGaugeReliability}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredGaugeReliability], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredVoltageSagScore}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredVoltageSagScore], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding RecoveredFirmwareChange}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredFirmwareChange], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{Binding Loc[ExportCollapseReport], Mode=OneWay}" Command="{Binding ExportRecoveredCommand}" MinWidth="170" Height="34"/>
                                    <TextBlock Text="{Binding RecoveredExportStatus}" Foreground="#7F1D1D" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#EFF6FF"
                                Visibility="{Binding HasRecoveredInterruption, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[DiagnosticSummary], Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[DiagnosticSummaryDetail], Mode=OneWay}" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DiagnosticCapacity}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[DiagnosticCapacity], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DiagnosticGauge}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[DiagnosticGauge], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DiagnosticVoltage}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[DiagnosticVoltage], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DiagnosticShutdown}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[DiagnosticShutdown], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding DiagnosticOverall}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[DiagnosticOverall], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding PercentageTrustStatus}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                Visibility="{Binding HasRecoveredInterruption, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[RecommendationHeading], Mode=OneWay}" Foreground="#9A3412" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RecommendationTitle}" FontSize="21" FontWeight="Bold" Foreground="#9A3412" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding RecommendationDetail}" Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                Visibility="{Binding HasBackgroundAlert, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[BackgroundAlertHeading], Mode=OneWay}" Foreground="#9A3412" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastBackgroundAlertTitle}" FontSize="19" FontWeight="Bold" Foreground="#9A3412" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LastBackgroundAlertDetail}" Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding LastBackgroundAlertTime}" Foreground="#9A3412" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#EFF6FF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[HealthScore], Mode=OneWay}" Foreground="#1E40AF" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding HealthScore}" FontSize="64" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Loc[CapacityBased], Mode=OneWay}" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding CapacitySourceNote}" Foreground="#64748B" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Condition}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="15" Foreground="#475569" Margin="0,8,20,0"/>
                                    <TextBlock Text="{Binding BatteryName}" FontSize="12" Foreground="#64748B" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,4,0,4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DesignCapacity}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[DesignCapacity], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding FullChargeCapacity}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[FullChargeCapacity], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Wear}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Wear], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding CycleCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[CycleCount], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Voltage}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Voltage], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding BatteryTemperature}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[BatteryTemperature], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding BatteryTemperatureSource}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding EstimatedCurrent}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[EstimatedCurrent], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Loc[EstimatedCurrentHint], Mode=OneWay}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DynamicResistance}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[DynamicResistance], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding DynamicResistanceConfidence}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding CurrentCharge}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Charge], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding PowerState}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[PowerState], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding PowerRate}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Rate], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Runtime}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Runtime], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding RuntimeSource}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[Analysis], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[History], Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Loc[HistoryHint], Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:HistoryPoint}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CapturedAt, StringFormat={}{0:g}}" Foreground="#4B5563"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding HealthPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ChargePercent, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="#6B7280"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Loc[LiveMonitor], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <Border Style="{StaticResource Card}" Background="#EFF6FF">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[LiveMonitorTitle], Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[LiveMonitorHint], Mode=OneWay}" Margin="0,5,0,0" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding PowerRate}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[CurrentPower], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding PowerDataStatus}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Average1Minute}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Average1Minute], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Average5Minutes}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Average5Minutes], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Runtime}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[BestRuntime], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding RuntimeSource}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Runtime1Minute}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Runtime1Minute], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Runtime5Minutes}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Runtime5Minutes], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding LiveSampleCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[PollingSamples], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding LiveValidPowerSampleCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[ValidPowerSamples], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding BatteryTemperature}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[BatteryTemperature], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding BatteryTemperatureSource}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TemperatureChange5Min}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TemperatureChange5Min], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding TemperatureRate}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding EstimatedCurrent}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[EstimatedCurrent], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Loc[EstimatedCurrentHint], Mode=OneWay}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DynamicResistance}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[DynamicResistance], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding DynamicResistanceConfidence}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding PowerTemperatureCorrelation}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[PowerTemperatureCorrelation], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Loc[CorrelationHint], Mode=OneWay}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TemperatureSampleCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TemperatureSamples], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[PowerTrend], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <controls:TrendChart Points="{Binding LivePowerTrend}" Unit=" W" Height="240" Stroke="#2563EB"/>
                                <TextBlock Text="{Binding Loc[PowerTrendHint], Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TemperatureTrend], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <controls:TrendChart Points="{Binding LiveTemperatureTrend}" Unit=" °C" Height="220" Stroke="#DC2626"/>
                                    <TextBlock Text="{Binding Loc[TemperatureTrendHint], Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[CurrentTrend], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <controls:TrendChart Points="{Binding LiveCurrentTrend}" Unit=" A" Height="220" Stroke="#7C3AED"/>
                                    <TextBlock Text="{Binding Loc[CurrentTrendHint], Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[AnomalyWatch], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding LiveAnomalies}" ItemTemplate="{StaticResource FindingTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Loc[BatteryTest], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <Border Style="{StaticResource Card}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                Visibility="{Binding HasRecoveredInterruption, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding RecoveredInterruptionTitle}" FontSize="21" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding RecoveredInterruptionDetail}" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredLastCharge}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredLastCharge], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredCurrentCharge}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredCurrentCharge], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredEnergy}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredEnergy], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredObservedEnergyVsDesign}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredObservedEnergyVsDesign], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding RecoveredConfidence}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[RecoveredConfidence], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="5" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredLastRemaining}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredLastRemaining], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredLastVoltage}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredLastVoltage], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredVoltageSagScore}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredVoltageSagScore], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredMaxVoltageSag}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredMaxVoltageSag], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding RecoveredSagEvents}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredSagEvents], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="4" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredGaugeReliability}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredGaugeReliability], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredBatteryReliability}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredBatteryReliability], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding RecoveredFirmwareChange}" Style="{StaticResource MetricValue}" FontSize="17"/><TextBlock Text="{Binding Loc[RecoveredFirmwareChange], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding RecoveredFirmwareEvent}" Foreground="#7F1D1D" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding RecoveredObservedVsReportedAvailable}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[RecoveredObservedVsReportedAvailable], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding Loc[ReliabilityScoreHint], Mode=OneWay}" Foreground="#7F1D1D" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RecoveredJournalPath}" Foreground="#991B1B" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{Binding Loc[ExportCollapseReport], Mode=OneWay}" Command="{Binding ExportRecoveredCommand}" MinWidth="170" Height="34"/>
                                    <TextBlock Text="{Binding RecoveredExportStatus}" Foreground="#7F1D1D" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#FFF7ED">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[BatteryTestTitle], Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Loc[BatteryTestHint], Mode=OneWay}" Foreground="#7C2D12" TextWrapping="Wrap" Margin="0,5,20,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,20,0">
                                        <TextBlock Text="{Binding Loc[TestProfile], Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <ComboBox Width="230" ItemsSource="{Binding TestProfiles}" SelectedItem="{Binding SelectedTestProfile}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsTestProfileEnabled}"/>
                                        <TextBlock Text="{Binding TestTarget}" VerticalAlignment="Center" Foreground="#64748B" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TestProfileHint}" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,5,20,0" FontSize="11"/>
                                    <TextBlock Text="{Binding Loc[CollapseJournalHint], Mode=OneWay}" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,3,20,0" FontSize="11"/>
                                    <TextBlock Text="{Binding TestStatus}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="{Binding TestButtonText}" Command="{Binding TestCommand}" MinWidth="145" Height="42"/>
                                    <Button Content="{Binding Loc[ExportReport], Mode=OneWay}" Command="{Binding ExportTestCommand}" MinWidth="145" Height="36" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestDuration}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestDuration], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestChargeDrop}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestChargeDrop], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestAveragePower}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestAveragePower], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestVoltageRange}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestVoltageRange], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestSampleCount}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestSamples], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestChargeStartEnd}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[TestChargeStartEnd], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestEnergyUsed}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestEnergyUsed], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding TestCapacityDeltaNote}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestAverageVoltage}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestAverageVoltage], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestValidPowerSamples}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestValidPowerSamples], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestConfidence}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[TestConfidence], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestEnergyAgreement}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestEnergyAgreement], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestDataConsistency}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[TestDataConsistency], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestEstimatedUsableCapacity}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestEstimatedUsableCapacity], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestEstimatedUsableHealth}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestEstimatedUsableHealth], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestVoltageSagScore}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[TestVoltageSagScore], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Loc[VoltageSagScoreHint], Mode=OneWay}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestVoltageSagEvents}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestVoltageSagEvents], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestMaxVoltageSag}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestMaxVoltageSag], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestAverageTemperature}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestAverageTemperature], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestTemperatureRange}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestTemperatureRange], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestTemperatureRise}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestTemperatureRise], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestAverageCurrent}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestAverageCurrent], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestDynamicResistance}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestDynamicResistance], Mode=OneWay}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Loc[DynamicResistanceHint], Mode=OneWay}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TestPowerTemperatureCorrelation}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[TestPowerTemperatureCorrelation], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Background="#EFF6FF">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[TestVerdictHeading], Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TestVerdictMode}" Foreground="#64748B" FontSize="11" Margin="0,3,0,8"/>
                                <TextBlock Text="{Binding TestVerdict}" FontSize="23" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock Text="{Binding TestVerdictDetail}" Foreground="#475569" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding TestExportStatus}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[TestPowerTrend], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <controls:TrendChart Points="{Binding TestPowerTrend}" Unit=" W" Height="240" Stroke="#EA580C"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[TestObservations], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding TestAnomalies}" ItemTemplate="{StaticResource FindingTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Loc[Trends], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <Border Style="{StaticResource Card}" Background="#F0FDF4">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[TrendTitle], Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[TrendHint], Mode=OneWay}" Foreground="#166534" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding HealthChange30Days}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[HealthChange30Days], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding HealthChange90Days}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[HealthChange90Days], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding HistorySpan}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[HistorySpan], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[HealthTrend], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <controls:TrendChart Points="{Binding HealthTrend}" Unit="%" Height="240" Stroke="#2563EB"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[CapacityTrend], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <controls:TrendChart Points="{Binding FullCapacityTrend}" Unit=" Wh" Height="240" Stroke="#059669"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Loc[SettingsAbout], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8,4,16">
                        <Border Style="{StaticResource Card}" Background="#EFF6FF">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[BackgroundMonitoringTitle], Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[BackgroundMonitoringHint], Mode=OneWay}" Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding BackgroundMonitoringStatus}" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[MonitoringSettings], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <CheckBox Content="{Binding Loc[EnableBackgroundMonitoring], Mode=OneWay}" IsChecked="{Binding BackgroundMonitoring}" Margin="0,6"/>
                                    <CheckBox Content="{Binding Loc[EnableTrayNotifications], Mode=OneWay}" IsChecked="{Binding TrayNotifications}" Margin="0,6"/>
                                    <CheckBox Content="{Binding Loc[MinimizeToTray], Mode=OneWay}" IsChecked="{Binding MinimizeToTray}" Margin="0,6"/>
                                    <CheckBox Content="{Binding Loc[StartWithWindows], Mode=OneWay}" IsChecked="{Binding StartWithWindows}" Margin="0,6"/>
                                    <TextBlock Text="{Binding Loc[StartupPrivacyHint], Mode=OneWay}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[LastBackgroundAlert], Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LastBackgroundAlertTitle}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LastBackgroundAlertDetail}" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LastBackgroundAlertTime}" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[AboutBatteryDoctor], Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[AboutDescription], Mode=OneWay}" Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding AppVersion}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[Version], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="GPL-3.0" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Loc[License], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ChemistryDisplay}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[Chemistry], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding Loc[OfflineOnly], Mode=OneWay}" Style="{StaticResource MetricValue}" FontSize="18"/><TextBlock Text="{Binding Loc[Privacy], Mode=OneWay}" Style="{StaticResource MetricLabel}"/></StackPanel>
                                </UniformGrid>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="{Binding Loc[OpenDataFolder], Mode=OneWay}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding Loc[OpenReportsFolder], Mode=OneWay}" Command="{Binding OpenReportsFolderCommand}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding Loc[TestNotification], Mode=OneWay}" Command="{Binding TestNotificationCommand}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding Loc[ExportDiagnosticSnapshot], Mode=OneWay}" Command="{Binding ExportDiagnosticCommand}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding Loc[ProjectPage], Mode=OneWay}" Command="{Binding OpenProjectCommand}" IsEnabled="{Binding ProjectLinkConfigured}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding Loc[SupportDevelopment], Mode=OneWay}" Command="{Binding OpenSupportCommand}" IsEnabled="{Binding SupportLinkConfigured}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding DiagnosticExportStatus}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SupportLinkStatus}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Loc[DonationNoUnlock], Mode=OneWay}" Foreground="#166534" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="#F0FDF4">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[PrivacyTitle], Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[PrivacyDetail], Mode=OneWay}" Foreground="#166534" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SettingsPath}" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Loc[PrivacyShort], Mode=OneWay}" Foreground="#166534" FontSize="11"/>
                    <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="#6B7280">
                        <Run Text="{Binding Loc[Database], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding DatabasePath, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LastUpdatedDisplay}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="24" VerticalAlignment="Bottom" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="#991B1B" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
